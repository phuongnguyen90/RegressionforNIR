  "train": {"epochs": 80, "batch_size": 64, "warmup_epochs": 3, "patience": 20, "log_every": 10, "lr": 0.0005},
  "inference": {"ensemble_size": 16},
  "localization": {"tolerance_nm": 15.0, "min_separation_nm": 10.0},
  "data": {
