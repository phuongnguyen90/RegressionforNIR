{
  "name": "fds_nir",
  "seed": 0,
  "runs": 3,
  "n_folds": 5,
  "model": {"patch_size": 32, "embed_dim": 512, "wavelength_embed": "fourier", "fourier_frequencies": 256,
            "encoder_dim": 512, "encoder_depth": 12, "encoder_heads": 8,
            "decoder_dim": 256, "decoder_depth": 4, "decoder_heads": 8},
  "mask": {"strategy": "cmsm", "ratio": 0.75, "k_min": 4, "k_max": 8, "l_min": 8, "l_max": 64},
  "loss": {"name": "casrl", "grad_weight": 0.5, "beta": 1.0},
  "train": {"epochs": 800, "batch_size": 32, "lr": 0.0001, "weight_decay": 0.05, "warmup_epochs": 10, "patience": 50},
  "inference": {"ensemble_size": 64},
  "localization": {"alpha": 0.5, "min_separation_nm": 10.0, "min_height": 0.10, "min_prominence": 0.08, "tolerance_nm": 10.0},
  "preprocess": {"savgol_window": 15, "savgol_order": 2, "snv": true, "minmax": true},
  "data": {
    "source": "table",
    "label_col": "subset",
    "normal_values": ["P", "T"],
    "subsets": [
      {"name": "ASD",        "path": "data/FDS-NIR/ASD.csv"},
      {"name": "MicroNIR",   "path": "data/FDS-NIR/MicroNIR.csv"},
      {"name": "NeoSpectra", "path": "data/FDS-NIR/NeoSpectra.csv"},
      {"name": "Scio",       "path": "data/FDS-NIR/Scio.csv"},
      {"name": "NIRONE",     "path": "data/FDS-NIR/NIRONE.csv"}
    ]
  }
}
